{
  "name": "school-metaverse",
  "version": "0.1.0",
  "private": true,
  "description": "2D school metaverse with 3D expansion path",
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npx serve .",
    "build": "cd shared && npm run build && cd ../server && npm run build",
    "start": "cd server && node dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
